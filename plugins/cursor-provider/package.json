{
  "name": "cursor-provider-plugin",
  "private": true,
  "version": "0.0.0",
  "description": "Cursor's coding agent through the official Cursor SDK, with the live model catalog, per-model reasoning effort, Fast mode, and automatic retry on rate limits.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "cursor",
    "provider"
  ],
  "author": "fidelix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fidelix/fidelix-paseo-plugins.git",
    "directory": "plugins/cursor-provider"
  },
  "homepage": "https://github.com/fidelix/fidelix-paseo-plugins/tree/main/plugins/cursor-provider#readme",
  "bugs": "https://github.com/fidelix/fidelix-paseo-plugins/issues",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "assets/",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "icon.svg",
    "dist/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:worker": "esbuild server/provider-worker.ts --bundle --platform=node --target=node22 --outfile=dist/provider-worker.cjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.10.3",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cursor/sdk": "^1.4.2",
    "esbuild": "0.28.2",
    "zod": "4.4.3"
  }
}
